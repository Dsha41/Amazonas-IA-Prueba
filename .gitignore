yolo*s.pt
# Los pesos base de YOLO los descarga scripts/setup_models.py, asi que no
# tiene sentido versionarlos (yolo11m.pt son 39 MB). Las reglas de arriba
# solo cubrian las variantes nano y small.
models/base/yolo*.pt

# ============================================================================
# Modelos opcionales NO incluidos en el repo
# ============================================================================
# El modelo de productos cosmeticos no se distribuye con el repo porque es
# entrenamiento propio. Si cosmetics_enabled=False (default) no se necesita.
models/cosmeticos/

# Modelos auxiliares de la rama Perimetrales (no usados por este repo)
models/osnet/
models/base/modelos/
